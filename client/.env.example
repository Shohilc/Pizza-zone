# Client API & Socket Endpoints
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5000

# Firebase Client Configuration (from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Google Maps API (Optional: for client-side Maps SDK)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google OAuth / Identity Services Client ID (Optional for direct Google OAuth)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


