# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/snackstore?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/snackstore

# Firebase Admin SDK
# You can provide either FIREBASE_SERVICE_ACCOUNT_JSON (stringified json) or path FIREBASE_CREDENTIALS_PATH
# Or FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: Keep the quotes and handle newlines with \n for private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Telegram Bot Alerts for Store Owner
# Create a bot via @BotFather on Telegram, get bot token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Chat ID of the store owner or channel/group (retrieve via @userinfobot or getUpdates)
TELEGRAM_OWNER_CHAT_ID=987654321

# Cloudinary Configuration (For menu item image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps API (For address geocoding and Places autocomplete)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Store Defaults
STORE_NAME="SnackCraft Kitchen"
STORE_PHONE="+91 98765 43210"
STORE_ADDRESS="Shop 12, Main Market, City"
DEFAULT_DELIVERY_FEE=30
MIN_ORDER_AMOUNT=99

# Admin Authentication
# Comma-separated list of emails that will automatically be given the 'admin' role upon login
ADMIN_EMAIL="admin@snackstore.local,your-email@gmail.com"
# Secret key used to claim or promote to admin role from /admin/login
ADMIN_SECRET_KEY="snackcraft-admin-2026"


